# Root .gitignore for ORYN-AI
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/

# Environment files and credentials (CRITICAL: Never commit to git)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
