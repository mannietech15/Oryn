# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# NVIDIA NIM / Inference API Keys
# Sign up at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_LOGIC_API_KEY=nvapi-your-logic-key-here
NVIDIA_APEX_API_KEY=nvapi-your-apex-key-here

# SMTP Email Configuration (Optional - falls back to mock logger if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
